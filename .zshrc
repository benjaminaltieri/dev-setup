# Zsh configuration for MacBook Pro M4
# Generated by dev-setup migration

# Homebrew (Apple Silicon path)
eval "$(/opt/homebrew/bin/brew shellenv)"

# Source shared aliases from dev-setup
SCRIPT_DIR="${0:A:h}"
if [[ -f "$SCRIPT_DIR/shell_aliases.sh" ]]; then
    source "$SCRIPT_DIR/shell_aliases.sh"
elif [[ -f ~/misc/dev-setup/shell_aliases.sh ]]; then
    source ~/misc/dev-setup/shell_aliases.sh
fi

# Rust/Cargo
[[ -f "$HOME/.cargo/env" ]] && source "$HOME/.cargo/env"

# UV (Python version management - replaces pyenv)
export PATH="$HOME/.local/bin:$PATH"

# NVM (Node version management)
export NVM_DIR="$HOME/.nvm"
[[ -s "$NVM_DIR/nvm.sh" ]] && source "$NVM_DIR/nvm.sh"
[[ -s "$NVM_DIR/bash_completion" ]] && source "$NVM_DIR/bash_completion"

# Go
export GOPATH=$HOME/go
export PATH="$HOME/go/bin:$PATH"

# Google Cloud SDK
if [[ -f "/opt/homebrew/Caskroom/google-cloud-sdk/latest/google-cloud-sdk/path.zsh.inc" ]]; then
    source "/opt/homebrew/Caskroom/google-cloud-sdk/latest/google-cloud-sdk/path.zsh.inc"
    source "/opt/homebrew/Caskroom/google-cloud-sdk/latest/google-cloud-sdk/completion.zsh.inc"
fi

# direnv (directory-specific environment variables)
if command -v direnv &> /dev/null; then
    eval "$(direnv hook zsh)"
fi

# History configuration (zsh equivalents of eternal bash history)
HISTSIZE=999999999
SAVEHIST=999999999
HISTFILE=~/.zsh_eternal_history
setopt EXTENDED_HISTORY          # Write timestamps to history
setopt SHARE_HISTORY             # Share history between sessions
setopt HIST_IGNORE_DUPS          # Ignore duplicate commands
setopt HIST_IGNORE_SPACE         # Ignore commands starting with space
setopt INC_APPEND_HISTORY        # Add commands immediately

# Claude Code alias
alias claude="$HOME/.claude/local/claude"
