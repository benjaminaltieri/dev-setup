#!/usr/bin/env python3
"""cdx-name-thread: name a just-started Codex session without touching its TUI.

Finds the thread a Codex session started in CWD whose first message is KICKOFF
and that was created at or after SINCE, then sets its name. Talks to a private
`codex app-server` over JSON-RPC on stdio (thread/list, thread/name/set), so it
never types into the session: a trust dialog, a slow MCP startup or an approval
prompt on screen cannot be answered by accident. A thread does not exist until
the session submits its first message, so waiting for it also waits out the
folder-trust question.

Usage: cdx-name-thread --cwd DIR --kickoff TEXT --since EPOCH --name NAME
                       [--timeout SEC]

Prints the thread id on success. Exit status:
  0  named
  2  no matching thread appeared within the timeout
  3  the app-server failed or refused the rename
  1  usage error

Verified on codex-cli 0.166.0 (2026-11-05): a name set this way survives the
session's own auto-titling and resolves in `codex resume` and `codex queue
--thread`. The running TUI does not learn the name, so its status line does not
show it.
"""

import argparse
import json
import signal
import subprocess
import sys
import threading
import time


class AppServer:
    def __init__(self) -> None:
        self.proc = subprocess.Popen(
            ["codex", "app-server"],
            stdin=subprocess.PIPE,
            stdout=subprocess.PIPE,
            stderr=subprocess.DEVNULL,
            text=True,
        )
        self.next_id = 0
        self.call("initialize", {"clientInfo": {"name": "cdx-name-thread", "version": "1"}})
        self._send({"jsonrpc": "2.0", "method": "initialized"})

    def _send(self, msg: dict) -> None:
        self.proc.stdin.write(json.dumps(msg) + "\n")
        self.proc.stdin.flush()

    def call(self, method: str, params: dict) -> dict:
        self.next_id += 1
        rid = self.next_id
        self._send({"jsonrpc": "2.0", "id": rid, "method": method, "params": params})
        for line in self.proc.stdout:
            try:
                msg = json.loads(line)
            except json.JSONDecodeError:
                continue
            if msg.get("id") != rid:
                continue  # a notification, or an answer to something else
            if "error" in msg:
                raise RuntimeError(f"{method}: {msg['error']}")
            return msg.get("result") or {}
        raise RuntimeError(f"codex app-server closed while waiting for {method}")

    def close(self) -> None:
        self.proc.kill()


def find_thread(srv: AppServer, cwd: str, kickoff: str, since: int) -> str | None:
    res = srv.call("thread/list", {"cwd": [cwd], "limit": 25})
    # cdx-spawn puts the session name in the kickoff, so cwd + kickoff + creation
    # time identifies one thread. Its current name is deliberately ignored: Codex
    # may auto-title the thread before this finds it.
    matches = sorted(
        (t for t in res.get("data", [])
         if (t.get("preview") or "").strip() == kickoff
         and int(t.get("createdAt") or 0) >= since),
        key=lambda t: int(t.get("createdAt") or 0),
        reverse=True,
    )
    return matches[0]["id"] if matches else None


def main() -> int:
    # cdx-spawn kills this process when Codex asks about folder trust; exiting
    # through SystemExit runs the finally block, so the app-server goes too.
    signal.signal(signal.SIGTERM, lambda *_: sys.exit(143))
    ap = argparse.ArgumentParser(description=__doc__.splitlines()[0])
    ap.add_argument("--cwd", required=True)
    ap.add_argument("--kickoff", required=True)
    ap.add_argument("--since", required=True, type=int)
    ap.add_argument("--name", required=True)
    ap.add_argument("--timeout", type=float, default=30)
    args = ap.parse_args()

    deadline = time.monotonic() + args.timeout
    # A wedged app-server must not outlive the deadline.
    killer = threading.Timer(args.timeout + 15, lambda: srv.close())
    try:
        srv = AppServer()
        killer.start()
        tid = None
        while time.monotonic() < deadline:
            tid = find_thread(srv, args.cwd, args.kickoff.strip(), args.since)
            if tid:
                break
            time.sleep(0.5)
        if not tid:
            return 2
        srv.call("thread/name/set", {"threadId": tid, "name": args.name})
        print(tid)
        return 0
    except Exception as exc:
        print(f"cdx-name-thread: {exc}", file=sys.stderr)
        return 3
    finally:
        killer.cancel()
        try:
            srv.close()
        except NameError:
            pass


if __name__ == "__main__":
    sys.exit(main())
